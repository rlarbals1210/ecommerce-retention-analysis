            <column caption='Retention Rate' datatype='real' default-format='p0.0%' name='[retention_rate]' role='measure' type='quantitative' />
            <column-instance column='[cohort_size]' derivation='Sum' name='[sum:cohort_size:qk]' pivot='key' type='quantitative' />
            <column-instance column='[retention_rate]' derivation='Sum' name='[sum:retention_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[users]' derivation='Sum' name='[sum:users:qk]' pivot='key' type='quantitative' />
