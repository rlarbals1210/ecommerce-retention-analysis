            <column caption="Cohort Size" datatype="integer" name="[cohort_size]" role="measure" type="quantitative" />
            <column-instance column="[cohort_month]" derivation="None" name="[none:cohort_month:nk]" pivot="key" type="nominal" />
            <column-instance column="[period_number]" derivation="None" name="[none:period_number:ok]" pivot="key" type="ordinal" />
            <column caption="Period Number" datatype="integer" name="[period_number]" role="dimension" type="ordinal" />
